{
  "name": "nestegg",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "seed:demo": "node --experimental-strip-types scripts/seed-demo.mjs",
    "sync": "node --experimental-strip-types scripts/sync.mjs",
    "test": "node --experimental-strip-types --test \"lib/**/*.test.mjs\" \"server/**/*.test.mjs\" \"scripts/*.test.mjs\"",
    "test:e2e": "node scripts/test-browser.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0"
  }
}
