{
  "name": "nestegg",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "seed:demo": "node --experimental-strip-types scripts/seed-demo.mjs",
    "sync": "node --experimental-strip-types scripts/sync.mjs",
    "test": "node --experimental-strip-types --test scripts/imports.test.mjs scripts/sync.test.mjs scripts/secrets.test.mjs scripts/schedule.test.mjs scripts/providers.test.mjs scripts/plaid.test.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
