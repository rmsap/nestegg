{
  "name": "nestegg",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "seed:demo": "node --experimental-strip-types scripts/seed-demo.mjs",
    "sync:teller-sandbox": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/sync-teller-sandbox.mjs",
    "test": "node --experimental-strip-types --test scripts/imports.test.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "postcss": "^8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0"
  }
}
